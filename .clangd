# Clangd configuration file
# See https://clangd.llvm.org/config for more information.

# Apply config conditionally (e.g. only for specific files)
# If:
#   PathMatch: .*\.h

Diagnostics:
  UnusedIncludes: None

Style:
  QuotedHeaders: ["/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/.*"]

CompileFlags:
  # Add flags to the compile command

  Add:
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/main
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/pch
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/core
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/core/log
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/core/thread
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/FileExplorer
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/console
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/window/widgets
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/window/widgets/history
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/window/persistence
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/handlers
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/preview_ui
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/image
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/image/dialog
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/image/downloader
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/image/widgets
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/video/player
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/video/downloader
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/video/video_preview
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/video/widgets
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/media/metadata_editor
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/ui/config
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/rendering
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/code/rendering/vulkan
    # ── ImGui (docking branch, all sub-directories) ─────────────────────────
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/external/imgui-1.92.8-docking
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/external/imgui-1.92.8-docking/backends
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/external/imgui-1.92.8-docking/misc/freetype
    # ── ImPlot ──────────────────────────────────────────────────────────────
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/external/implot
    # ── SDL3 ────────────────────────────────────────────────────────────────
    - -I/home/joao/.local/include/SDL3
    # ── Vulkan ──────────────────────────────────────────────────────────────
    - -I/usr/include/vulkan
    - -I/usr/include
    # ── Freetype2 ───────────────────────────────────────────────────────────
    - -I/home/joao/.local/include/freetype2
    # ── PlutoSVG / PlutoVG ──────────────────────────────────────────────────
    - -I/home/joao/.local/include
    # ── vcpkg installed packages ─────────────────────────────────────────────
    - -I/home/joao/vcpkg/installed/x64-linux/include
    - -I/home/joao/vcpkg/installed/x64-linux/include/stb
    - -I/home/joao/vcpkg/installed/x64-linux/include/webp
    - -I/home/joao/vcpkg/installed/x64-linux/include/curl
    - -I/home/joao/vcpkg/installed/x64-linux/include/rfl
    # ── project-local vcpkg ──────────────────────────────────────────────────
    - -I/home/joao/vscode/my_imgui/Project_sdl3_vulkan/vcpkg_installed/x64-linux/include
    # ── MPV ─────────────────────────────────────────────────────────────────
    - -I/usr/include/mpv
    # ── Warnings ────────────────────────────────────────────────────────────
    - -Wall
    - -Wformat
    - -Winfinite-recursion
    - -Warray-bounds
    - -Wreturn-stack-address
    - -Werror=implicit-function-declaration
    - -Wshadow
    - -Wuninitialized
    # ── C++ standard ────────────────────────────────────────────────────────
    - -std=c++23
    # ── Preprocessor definitions ─────────────────────────────────────────────
    - -DAPP_USE_VULKAN_DEBUG_REPORT
    - -DIMGUI_FONTS_DIR="/home/joao/vscode/my_imgui/Project_sdl3_vulkan/external/imgui-1.92.8-docking/misc/fonts"
  Compiler: clang++               # Change argv[0] of compile flags to `clang++`
  CompilationDatabase: Ancestors

Completion:
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU
  CodePatterns: All

Hover:
  ShowAKA: true
  MacroContentsLimit: 4096

Documentation:
  CommentFormat: Doxygen

Index:
  Background: Build
  StandardLibrary: true

InlayHints:
  BlockEnd: false
  Designators: true
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  DefaultArguments: true
  TypeNameLimit: 0

SemanticTokens:
  DisabledKinds: []
  DisabledModifiers: []
 
 
# Press Ctrl+Space to bring up completion suggestions
