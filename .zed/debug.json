[
  {
    "label": "debug: Debug",
    "build": {
      "command": "cmake",
      "args": ["--build", "$ZED_WORKTREE_ROOT/build/all", "--config", "Debug", "-j4"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/debug/example_sdl3_vulkan_debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "adapter": "CodeLLDB"
  },
  {
    "label": "debug: RelWithDebInfo",
    "build": {
      "command": "cmake",
      "args": ["--build", "$ZED_WORKTREE_ROOT/build/all", "--config", "RelWithDebInfo", "-j4"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/release-log/example_sdl3_vulkan_release-log",
    "cwd": "$ZED_WORKTREE_ROOT",
    "adapter": "CodeLLDB"
  }
]
